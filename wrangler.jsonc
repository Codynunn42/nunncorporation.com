{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nunn-corporation-website",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "aec8e5cc133b459aa63e63fff1df2e3b",
      "preview_id": "aec8e5cc133b459aa63e63fff1df2e3b"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
